---
interface Props {
  tipo?: string;
}

const {tipo} = Astro.props
---

<div class="w-full max-w-sm mx-auto bg-white p-10 rounded-2xl shadow-sm border border-slate-100">
  
  <!-- Encabezado -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight text-orange-600">
      {tipo=='creacion'?'Registro':'Ingresa'}
    </h1>
    <p class="text-sm text-slate-500 mt-2">
      Por favor ingresa tus credenciales para continuar.
    </p>
  </div>

  <!-- Formulario -->
  <form id=`formulario_${tipo}_usuario` class="space-y-6" action="#" method="POST">
    
    <!-- Nombre de usuario  -->
    <div>
      <label for=`nombre_usuario` class="block text-sm font-semibold text-slate-700 mb-2">
        Usuario
      </label>
      <input 
        type="text" 
        id= `nombre_usuario`
        name=`nombre_usuario` 
        placeholder="Ej. jperez" 
        required
        class="w-full px-2 py-3 text-sm bg-transparent border-b-2 border-t-0 border-x-0 border-orange-100 text-slate-800 placeholder-slate-400 rounded-none focus:outline-none focus:border-orange-600 focus:ring-0 transition-colors"
      />
    </div>

    <!-- Contraseña  -->
    <div>
      <label for=`clave` class="block text-sm font-semibold text-slate-700 mb-2">
        Contraseña
      </label>
      <input 
        type="password" 
        id=`clave` 
        name=`clave` 
        placeholder="••••••••" 
        required
        class="w-full px-2 py-3 text-sm bg-transparent border-b-2 border-t-0 border-x-0 border-orange-100 text-slate-800 placeholder-slate-400 rounded-none focus:outline-none focus:border-orange-600 focus:ring-0 transition-colors"
      />
    </div>


    <!-- Submit -->
    <div class="pt-2">
      <button 
        type="submit" 
        class="w-full py-3 px-5 bg-orange-600 hover:bg-orange-700 text-white text-base font-medium rounded-xl shadow-sm transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-500">
        {`${tipo=='creacion'?'Registrar Usuario':'Ingresar'}`}
      </button>
    </div>

  </form>
  <!-- Contenedor de mensaje de estado -->
  <div id="mensaje-estado" class="mt-4 w-full text-center text-sm font-medium rounded-xl transition-all duration-300 empty:hidden"></div>

</div>